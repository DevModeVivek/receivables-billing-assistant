# Copy to .streamlit/secrets.toml for local use, or paste into the app's
# Secrets box on Streamlit Community Cloud. Never commit real keys.

# Which assistant to use: "gemini", "claude" or "ollama".
# Leave it out to use the first one that is configured.
AI_PROVIDER = "gemini"

# Google AI Studio key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY = "paste-your-key-here"
# Optional: change the model if Google renames or retires it
# GEMINI_MODEL = "gemini-3.5-flash-lite"   (or "gemini-3.8-flash")

# Optional: Anthropic key, if you prefer Claude
# ANTHROPIC_API_KEY = ""
